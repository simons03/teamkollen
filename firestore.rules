rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Struktur:
    //   weeks/{2026-W38}                                   { year, week }
    //   weeks/{2026-W38}/sections/{sektion-a}              { sectionId, name, year, week }
    //   weeks/{2026-W38}/sections/{sektion-a}/responses/…  { answers, createdAt }
    //
    // Anonyma klienter får bara skriva. Ingen läsning, ändring av svar eller radering.

    function validWeek(weekId, data) {
      return weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.year is int
        && data.week is int
        && data.week >= 1 && data.week <= 53
        && weekId == string(data.year) + '-W' + (data.week < 10 ? '0' : '') + string(data.week)
        // Tillåt bara innevarande år (± 1 för veckor som korsar årsskiftet).
        && data.year >= request.time.year() - 1
        && data.year <= request.time.year() + 1;
    }

    function score(v) {
      return v is int && v >= 0 && v <= 100;
    }

    function validAnswers(a) {
      return a is map
        && a.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10'])
        && a.size() == 10
        && score(a.q1) && score(a.q2) && score(a.q3) && score(a.q4) && score(a.q5)
        && score(a.q6) && score(a.q7) && score(a.q8) && score(a.q9) && score(a.q10);
    }

    match /weeks/{weekId} {
      allow create, update: if request.resource.data.keys().hasOnly(['year', 'week'])
        && validWeek(weekId, request.resource.data);

      match /sections/{sectionId} {
        allow create, update: if sectionId.matches('^[a-z0-9-]{1,50}$')
          && request.resource.data.keys().hasOnly(['sectionId', 'name', 'year', 'week'])
          && request.resource.data.sectionId == sectionId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && validWeek(weekId, request.resource.data);

        match /responses/{responseId} {
          allow create: if request.resource.data.keys().hasOnly(['answers', 'createdAt'])
            && validAnswers(request.resource.data.answers)
            && request.resource.data.createdAt == request.time;
        }
      }
    }
  }
}
